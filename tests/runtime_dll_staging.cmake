cmake_minimum_required(VERSION 3.25)

file(MAKE_DIRECTORY "${TEST_ROOT}/source" "${TEST_ROOT}/staged")
set(runtime "${TEST_ROOT}/source/runtime.dll")
set(extra "${TEST_ROOT}/source/additional.txt")
set(destination "${TEST_ROOT}/staged")
set(stage_script "${TEST_ROOT}/stage.cmake")
file(WRITE "${runtime}" "native runtime input\n")
file(WRITE "${extra}" "additional runtime input\n")
file(WRITE "${stage_script}"
"set(VNM_RUNTIME_DLLS_LOCK_ROOT [==[${TEST_ROOT}/locks]==])
include([==[${PROVIDER_SOURCE}/cmake/vnm_runtime_dlls_stage.cmake]==])
vnm_stage_runtime_files([==[${destination}]==] [==[${runtime};${extra}]==])
vnm_stage_runtime_files([==[${destination}]==] [==[${runtime}]==])
")

foreach(case initial unchanged changed missing)
    if(case STREQUAL "changed")
        file(WRITE "${runtime}" "updated native input\n")
        file(WRITE "${extra}" "updated additional input\n")
    elseif(case STREQUAL "missing")
        file(REMOVE "${destination}/runtime.dll" "${destination}/additional.txt")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${stage_script}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Runtime staging ${case} failed:\n${output}\n${error}")
    endif()
    foreach(source IN ITEMS "${runtime}" "${extra}")
        get_filename_component(name "${source}" NAME)
        file(SHA256 "${source}" source_hash)
        file(SHA256 "${destination}/${name}" staged_hash)
        if(NOT source_hash STREQUAL staged_hash)
            message(FATAL_ERROR "Runtime staging ${case} produced different bytes for ${name}.")
        endif()
    endforeach()
    file(TIMESTAMP "${destination}/runtime.dll" staged_time "%s.%f")
    if(case STREQUAL "unchanged" AND NOT staged_time STREQUAL previous_time)
        message(FATAL_ERROR "Runtime staging rewrote an unchanged DLL.")
    endif()
    set(previous_time "${staged_time}")
endforeach()

file(REMOVE "${runtime}")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${stage_script}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0)
    message(FATAL_ERROR "Runtime staging accepted a missing producer file.")
endif()
