cmake_minimum_required(VERSION 3.16)
find_program(git NAMES git)
if(NOT git)
    message(FATAL_ERROR "Acquisition fixtures require Git")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/workspace/sample_dependency" "${TEST_ROOT}/workspace/consumer")
file(WRITE "${TEST_ROOT}/workspace/sample_dependency/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.16)
project(sample_dependency LANGUAGES NONE)
get_property(already_added GLOBAL PROPERTY SAMPLE_DEPENDENCY_ADDED)
if(already_added)
    message(FATAL_ERROR "Dependency was configured more than once")
endif()
set_property(GLOBAL PROPERTY SAMPLE_DEPENDENCY_ADDED TRUE)
set(SAMPLE_FILES_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/files" CACHE PATH "Sample files")
add_library(sample_dependency INTERFACE)
add_library(sample::dependency ALIAS sample_dependency)
]=])

if(CASE STREQUAL "worktree" OR CASE STREQUAL "fetch")
    if(CASE STREQUAL "worktree")
        set(repository "${TEST_ROOT}/workspace/consumer")
        file(WRITE "${repository}/README" "Workspace discovery fixture\n")
    else()
        set(repository "${TEST_ROOT}/workspace/sample_dependency")
    endif()
    foreach(command IN ITEMS init add commit)
        if(command STREQUAL "init")
            set(args init -b master)
        elseif(command STREQUAL "add")
            set(args add .)
        else()
            set(args -c user.name=Fixture -c user.email=fixture@example.invalid
                commit --allow-empty -m "Acquisition fixture")
        endif()
        execute_process(COMMAND "${git}" -C "${repository}" ${args}
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Fixture ${command} failed: ${error}")
        endif()
    endforeach()
    if(CASE STREQUAL "worktree" AND NOT EXISTS "${TEST_ROOT}/linked/.git")
        execute_process(COMMAND "${git}" -C "${repository}" worktree add --detach "${TEST_ROOT}/linked"
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Worktree fixture failed: ${error}")
        endif()
    endif()
endif()

set(command "${CMAKE_COMMAND}" -S "${PROVIDER_SOURCE}/tests/acquisition"
    -B "${TEST_ROOT}/build" -G "${GENERATOR}"
    "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}"
    "-DCASE=${CASE}" "-DTEST_ROOT=${TEST_ROOT}"
    "-DPROVIDER_SOURCE=${PROVIDER_SOURCE}")
execute_process(COMMAND ${command}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(CASE STREQUAL "invalid")
    if(result EQUAL 0 OR NOT error MATCHES "FETCHCONTENT_SOURCE_DIR_SAMPLE_DEPENDENCY does not contain")
        message(FATAL_ERROR "Invalid source was not rejected at the override boundary: ${output}\n${error}")
    endif()
elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "Acquisition ${CASE} failed: ${output}\n${error}")
endif()
