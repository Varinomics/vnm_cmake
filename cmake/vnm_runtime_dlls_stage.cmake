include_guard(GLOBAL)

function(vnm_stage_runtime_files destination files)
    list(FILTER files EXCLUDE REGEX "^$")
    if(NOT files)
        return()
    endif()
    file(MAKE_DIRECTORY "${destination}")
    file(REAL_PATH "${destination}" destination_identity)
    if(WIN32)
        string(TOLOWER "${destination_identity}" destination_identity)
    endif()
    string(SHA256 lock_key "${destination_identity}")
    file(MAKE_DIRECTORY "${VNM_RUNTIME_DLLS_LOCK_ROOT}")
    # Aggregate and individually requested stages may share this directory.
    # Lock by actual destination so independent runtime layouts remain parallel.
    file(LOCK "${VNM_RUNTIME_DLLS_LOCK_ROOT}/${lock_key}.lock"
        GUARD FUNCTION TIMEOUT 600 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Could not stage runtime files in ${destination}: ${lock_result}")
    endif()
    get_property(staged_pairs GLOBAL PROPERTY VNM_RUNTIME_DLLS_STAGED_PAIRS)
    foreach(runtime_file IN LISTS files)
        get_filename_component(name "${runtime_file}" NAME)
        set(destination_file "${destination}/${name}")
        set(pair "${runtime_file}|${destination_file}")
        list(FIND staged_pairs "${pair}" pair_index)
        if(NOT pair_index EQUAL -1)
            continue()
        endif()
        file(COPY_FILE "${runtime_file}" "${destination_file}" ONLY_IF_DIFFERENT)
        list(APPEND staged_pairs "${pair}")
    endforeach()
    set_property(GLOBAL PROPERTY VNM_RUNTIME_DLLS_STAGED_PAIRS "${staged_pairs}")
endfunction()
